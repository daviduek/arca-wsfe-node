{
  "name": "arca-wsfe",
  "version": "0.1.0",
  "description": "Cliente Node.js/TypeScript para facturacion electronica de ARCA (ex AFIP): WSAA + WSFEv1, emision con CAE, notas de credito/debito y QR fiscal.",
  "keywords": [
    "arca",
    "afip",
    "wsfe",
    "wsfev1",
    "wsaa",
    "factura-electronica",
    "cae",
    "argentina",
    "monotributo",
    "qr-fiscal"
  ],
  "license": "MIT",
  "author": "daviduek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daviduek/arca-wsfe-node.git"
  },
  "bugs": {
    "url": "https://github.com/daviduek/arca-wsfe-node/issues"
  },
  "homepage": "https://github.com/daviduek/arca-wsfe-node#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:homologacion": "tsx examples/homologacion.ts",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.12.1",
    "node-forge": "^1.4.3",
    "qrcode": "^1.5.4",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
